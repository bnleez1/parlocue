pkgname=recite
pkgver=0.1.0
pkgrel=1
pkgdesc='Turn audio scripts into multi-voice MP3s'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'ffmpeg' 'python' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/recite "$pkgdir/usr/bin/recite"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/recite.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/recite.svg"
  install -Dm644 "$startdir/recite.desktop" "$pkgdir/usr/share/applications/recite.desktop"
}
